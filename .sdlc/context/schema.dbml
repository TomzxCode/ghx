  assignees     text    [not null, note: 'JSON text']
  labels        text    [not null, note: 'JSON text']
  milestone     text    [note: 'JSON text or NULL']
  created_at    text    [not null]
  updated_at    text    [not null]
  closed_at     text
  url           text    [not null]
  body          text    [not null]
  comment_count integer [not null]
  comments      text    [not null, note: 'JSON text']
  row_mtime     text    [not null]

  indexes {
    (host, owner, repo, number) [pk, name: 'issues_pk']
    (host, owner, repo, state) [name: 'idx_issues_state']
    (host, owner, repo, author_login) [name: 'idx_issues_author']
    (host, owner, repo, updated_at) [name: 'idx_issues_updated']
  }
}

